{
  "name": "@studyluma/app",
  "version": "0.2.0",
  "description": "StudyLuma learning platform: course views, worksheets and lesson frames.",
  "private": true,
  "type": "module",
  "exports": {
    "./app/root": "./app/root.tsx",
    "./app/root.server": "./app/root.server.ts",
    "./app/routes/asset": "./app/routes/asset.ts",
    "./app/routes/check": "./app/routes/check.ts",
    "./app/routes/*.server": "./app/routes/*.server.ts",
    "./app/routes/*": "./app/routes/*.tsx",
    "./app/routes/classroom": "./app/routes/classroom.ts",
    "./app/routes/classroomSocket": "./app/routes/classroomSocket.ts",
    "./app/routes/gatewaySessions": "./app/routes/gatewaySessions.ts",
    "./app/routes/sessionProbe": "./app/routes/sessionProbe.ts",
    "./app/StudyShell": "./app/StudyShell.tsx",
    "./app/StudyShellLayout": "./app/StudyShellLayout.tsx",
    "./app/site.server": "./app/site.server.ts",
    "./app/app.css": "./app/app.css",
    "./modules/courses": "./src/modules/courses/index.ts",
    "./modules/worksheets": "./src/modules/worksheets/index.ts",
    "./modules/classroom": "./src/modules/classroom/index.ts"
  },
  "chromatis": {
    "manifest": "./dist/chromatis.manifest.json"
  },
  "files": [
    "app",
    "src",
    "server",
    "dist/chromatis.manifest.json",
    "public",
    "!**/*.test.ts",
    "!**/*.test.tsx",
    "!**/*.workerd.entry.ts",
    "!src/test"
  ],
  "scripts": {
    "manifest": "bun scripts/generate-manifest.ts",
    "manifest:check": "bun scripts/generate-manifest.ts --check",
    "build": "bun run manifest",
    "prepack": "bun run manifest",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier app src server scripts package.json tsconfig.json eslint.config.js --check",
    "check": "bun run manifest && bun run check:boundaries && bun run typecheck && bun run lint && bun run format:check && bun run test && bun run manifest:check",
    "check:boundaries": "bun ../../scripts/check-boundaries.ts"
  },
  "dependencies": {
    "@chromatis/base": "workspace:*",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/stix-two-math": "^5.2.0",
    "@react-router/node": "^7.9.0",
    "@react-router/serve": "^7.9.0",
    "@studyluma/catalog-contract": "workspace:*",
    "@studyluma/component-api": "workspace:*",
    "isbot": "^5.1.0",
    "kern-typ": "^0.2.0",
    "lucide-react": "^0.546.0",
    "mafs": "0.21.0",
    "prism-react-renderer": "^2.4.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.9.0",
    "rehype-react": "^8.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@react-router/dev": "^7.9.0",
    "@types/bun": "^1.3.8",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0"
  }
}
