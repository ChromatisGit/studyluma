{
  "name": "@studyluma/compiler",
  "version": "0.2.0",
  "description": "StudyLuma content compiler: author Markdown in, catalog artifact (see @studyluma/catalog-contract) out. Build time only.",
  "type": "module",
  "bin": {
    "studyluma-compiler": "./cli.ts"
  },
  "exports": {
    "./authored-files": "./src/authored-files.ts",
    "./contribution": "./src/contribution.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "cli.ts",
    "src"
  ],
  "scripts": {
    "compile": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run format:check && bun run test",
    "format:check": "prettier . --check"
  },
  "dependencies": {
    "@studyluma/catalog-contract": "workspace:*",
    "kern-typ": "0.2.0",
    "smol-toml": "^1.3.4",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.8",
    "@types/node": "^22.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  }
}
