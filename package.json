{
  "name": "studyluma",
  "version": "0.1.0",
  "description": "React Router SSR web application for the StudyLuma learning platform.",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node build/server/index.js",
    "check": "react-router typegen && tsc --noEmit",
    "db": "bun run node_modules/@chromatis/base/infra/scripts/db.ts",
    "db:provision": "bun run scripts/milestone/provisionRoles.ts",
    "db:apply": "bun run node_modules/@chromatis/base/infra/scripts/db.ts apply",
    "seed:milestone": "bun run scripts/milestone/seed.ts",
    "verify:milestone": "bun run scripts/milestone/verify.ts",
    "verify:milestone:rls": "bun run scripts/milestone/verifyRls.ts"
  },
  "dependencies": {
    "@chromatis/base": "git+https://github.com/ChromatisGit/chromatis-base-framework.git#80ca0af",
    "@neondatabase/serverless": "^1.0.2",
    "@react-router/node": "^7.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "image-size": "^2.0.2",
    "kern-typ": "^0.2.0",
    "lucide-react": "^0.462.0",
    "motion": "^12.39.0",
    "postgres": "^3.4.8",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.0.0",
    "rehype-react": "^8.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@react-router/dev": "^7.0.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^20.19.32",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-boundaries": "^5.4.0",
    "knip": "^6.14.2",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "wrangler": "^4.92.0"
  }
}
