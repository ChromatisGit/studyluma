{
  "name": "studyluma",
  "version": "0.2.0",
  "description": "StudyLuma learning platform: course views, worksheets and lesson frames.",
  "private": true,
  "type": "module",
  "exports": {
    "./app/root": "./app/root.tsx",
    "./app/routes/*": "./app/routes/*.tsx",
    "./app/StudyShell": "./app/StudyShell.tsx",
    "./app/app.css": "./app/app.css",
    "./modules/viewer": "./src/modules/viewer/index.ts",
    "./modules/content": "./src/modules/content/index.ts",
    "./modules/courses": "./src/modules/courses/index.ts",
    "./modules/worksheets": "./src/modules/worksheets/index.ts",
    "./modules/quiz": "./src/modules/quiz/index.ts",
    "./modules/lessons": "./src/modules/lessons/index.ts"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "react-router-serve build/server/index.js",
    "test": "bun test",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test"
  },
  "dependencies": {
    "@chromatis/base": "git+https://github.com/ChromatisGit/chromatis-base-framework.git#claude/adoring-babbage-21pa67",
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/stix-two-math": "^5.2.0",
    "@react-router/node": "^7.9.0",
    "@react-router/serve": "^7.9.0",
    "isbot": "^5.1.0",
    "kern-typ": "^0.2.0",
    "lucide-react": "^0.546.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.9.0",
    "rehype-react": "^8.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@react-router/dev": "^7.9.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@types/unist": "^3.0.3",
    "@types/mdast": "^4.0.4",
    "eslint": "^9.39.2",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0"
  }
}
