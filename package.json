{
  "name": "studyluma",
  "version": "0.1.0",
  "description": "React Router SSR web application for the StudyLuma learning platform.",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./root": "./app/root.tsx",
    "./entry.client": "./app/entry.client.tsx",
    "./entry.server": "./app/entry.server.tsx",
    "./routes/home": "./src/app/routes/home.tsx",
    "./routes/login": "./src/app/routes/login.tsx",
    "./routes/logout": "./src/app/routes/logout.tsx",
    "./routes/course": "./src/app/routes/course.tsx",
    "./routes/chapter": "./src/app/routes/chapter.tsx",
    "./routes/worksheet": "./src/app/routes/worksheet.tsx",
    "./routes/publish": "./src/app/routes/publish.ts",
    "./views/home": "./src/modules/courses/ui/home.tsx",
    "./views/course": "./src/modules/courses/ui/course.tsx",
    "./views/chapter": "./src/modules/courses/ui/chapter.tsx",
    "./views/login": "./src/app/views/login.tsx",
    "./views/logout": "./src/app/views/logout.tsx",
    "./views/worksheet": "./src/modules/worksheets/ui/worksheet.tsx",
    "./setup/provision-roles": "./scripts/milestone/provisionRoles.ts",
    "./setup/seed": "./scripts/milestone/seed.ts"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node build/server/index.js",
    "check": "react-router typegen && bun run typecheck && bun run lint && bun run format:check && bun run config:check && bun run db:check && bun run test",
    "fix": "eslint . --fix && prettier . --write && bun run check",
    "test": "bun test",
    "doctor": "bun run node_modules/@chromatis/base/infra/scripts/doctor.ts",
    "config": "bun run node_modules/@chromatis/base/infra/scripts/config.ts",
    "secret": "bun run node_modules/@chromatis/base/infra/scripts/secret.ts",
    "db": "bun run node_modules/@chromatis/base/infra/scripts/db.ts",
    "deploy": "bun run node_modules/@chromatis/base/infra/scripts/deploy.ts",
    "lint": "eslint . --max-warnings 0 --report-unused-disable-directives",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier . --check",
    "config:check": "bun run config",
    "db:check": "bun run node_modules/@chromatis/base/infra/scripts/dbCheckGeneratedMigrations.ts"
  },
  "dependencies": {
    "@chromatis/base": "git+https://github.com/ChromatisGit/chromatis-base-framework.git#80ca0af",
    "@neondatabase/serverless": "^1.0.2",
    "@react-router/node": "^7.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "image-size": "^2.0.2",
    "kern-typ": "^0.2.0",
    "lucide-react": "^0.462.0",
    "motion": "^12.39.0",
    "postgres": "^3.4.8",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^7.0.0",
    "rehype-react": "^8.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sonner": "^2.0.7",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.37.1",
    "@react-router/dev": "^7.0.0",
    "@types/bun": "^1.3.8",
    "@types/node": "^20.19.32",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "knip": "^6.14.2",
    "tailwindcss": "^4.3.0",
    "typescript-eslint": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "^5.0.0",
    "wrangler": "^4.92.0",
    "prettier": "^3.6.2"
  },
  "patchedDependencies": {
    "@chromatis/base@github:ChromatisGit/chromatis-base-framework#80ca0af": "patches/@chromatis%2Fbase@github%3AChromatisGit%2Fchromatis-base-framework#80ca0af.patch"
  }
}
